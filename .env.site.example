# On-premises SITE SERVER config (offline Stage 16).
# Copy to .env.site and fill in. Used by docker-compose.site.yml.

# --- Local database (on the site box) ---
DB_NAME=riceflow_site
DB_USER=riceflow
DB_PASSWORD=change-me-strong-local-password

# --- Auth ---
# MUST equal the cloud's JWT_SECRET so tokens are compatible across site<->cloud.
JWT_SECRET=change-me-must-match-cloud
JWT_EXPIRES_IN=24h
CORS_ORIGIN=http://localhost

# --- Site identity & cloud link ---
SITE_ID=mill-lahore-1
CLOUD_API_URL=https://agricommodities.online

# --- Sync service account (a dedicated cloud user; Super Admin/Owner recommended so
#     replayed writes clear RBAC). Create it on the cloud before first run. ---
SYNC_USER=site-sync@agricommodities.online
SYNC_PASSWORD=change-me-service-account-password

# --- Sync tuning (optional) ---
SITE_SYNC_INTERVAL_MS=60000
SITE_PULL_DOMAINS=customers,suppliers,products,warehouses,bank_accounts

# --- Frontend (optional) ---
VITE_TURNSTILE_SITE_KEY=
